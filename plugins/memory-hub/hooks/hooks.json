{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/codex_hook_entry.py\" SessionStart",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\codex_hook_entry.py\" SessionStart",
            "timeout": 15,
            "statusMessage": "memory-hub: 注入记忆规则"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/codex_hook_entry.py\" UserPromptSubmit",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\codex_hook_entry.py\" UserPromptSubmit",
            "timeout": 3,
            "statusMessage": "memory-hub: 召回相关记忆"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/codex_hook_entry.py\" Stop",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\codex_hook_entry.py\" Stop",
            "timeout": 3,
            "statusMessage": "memory-hub: 采集会话"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/codex_hook_entry.py\" SessionEnd",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\codex_hook_entry.py\" SessionEnd",
            "timeout": 3,
            "statusMessage": "memory-hub: 会话结束采集"
          }
        ]
      }
    ]
  }
}
